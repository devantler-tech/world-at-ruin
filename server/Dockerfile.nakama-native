# Explicit disposable acceptance image; this is not a production deployment target.
FROM golang:1.27.2@sha256:5bc7f572bbaa98885a3a1fd9c0aa76b59e3e14e8628bfc316bbfd0c701e4818c AS trial
ARG EXPERIMENTAL=false
RUN test "$EXPERIMENTAL" = true
WORKDIR /source/server
COPY server/go.mod server/go.sum ./
COPY server/nakama-runtime/ ./nakama-runtime/
RUN sha256sum nakama-runtime/go.mod nakama-runtime/go.sum > /tmp/locked-graph.sha256 \
    && go mod download -modfile=nakama-runtime/go.mod \
    && sha256sum -c /tmp/locked-graph.sha256
COPY server/ ./
COPY tools/nakama-runtime-build/ /source/tools/nakama-runtime-build/
RUN CGO_ENABLED=0 go build -mod=readonly -trimpath -buildvcs=false -o /out/zone ./cmd/zone \
 && sha256sum /out/zone > /out/zone.sha256
RUN GOBIN=/out go install golang.org/x/vuln/cmd/govulncheck@v1.7.0 \
    && GOFLAGS='-mod=readonly -modfile=nakama-runtime/go.mod' /out/govulncheck \
      github.com/heroiclabs/nakama/v3 ./cmd/nakama
RUN go run ../tools/nakama-runtime-build/main.go ../tools/nakama-runtime-build/build.go \
      -experimental -source . -output /out/bundle \
    && go test -mod=readonly -modfile=nakama-runtime/go.mod -tags=war_native_trial \
      -c -o /out/native-trial.test ./internal/nakamatrial \
    && mkdir /out/bundle/mismatched-modules \
    && go build -mod=readonly -modfile=nakama-runtime/go.mod -trimpath -buildvcs=false \
      -race -buildmode=plugin -o /out/bundle/mismatched-modules/world_at_ruin.so ./cmd/nakama
RUN mkdir -p /var/run/secrets/kubernetes.io/serviceaccount \
    && chown 10001:10001 /var/run/secrets/kubernetes.io/serviceaccount \
    && chown -R 10001:10001 /out/bundle
USER 10001:10001
ENTRYPOINT ["/out/native-trial.test"]
# Default invocation refuses the trial rather than opening a server or database.
CMD ["-war-bundle=/out/bundle"]
